{
	"schemaVersion": 1,
	"id": "fiw-clock",
	"version": "${version}",
	"name": "Tickwatch",
	"description": "Lightweight, server-side tracker for player playtime, kills and deaths. Saves to a crash-safe JSON file per world.",
	"authors": [
		"fiw"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/tickwatch",
		"sources": "https://github.com/Fi3w0/Fiw-Clock",
		"issues": "https://github.com/Fi3w0/Fiw-Clock/issues"
	},
	"license": "MIT",
	"icon": "assets/fiw-clock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.fiw.fabric.TickwatchFabric",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.0"
	}
}